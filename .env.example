# ─── Provider API keys ─────────────────────────────────────────────────────────
# At least one of these must be set for agents that hit a hosted model.

# Official OpenAI (GPT-4o, GPT-4o-mini, text-embedding-3-small, ...)
OPENAI_API_KEY=sk-...

# Official Anthropic (Claude Opus 4.6, Sonnet 4.5)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Third-party OpenAI-compatible providers (optional) ────────────────────────
# Any vendor that exposes /v1/chat/completions works: DeepSeek, Moonshot,
# Volcengine Ark, SiliconFlow, OpenRouter, Azure OpenAI, self-hosted vLLM/
# Ollama in OpenAI mode, etc.
#
# Point at the provider's OpenAI-compatible base URL and key. Once
# OPENAI_COMPAT_BASE_URL is set, the built-in profile ``openai_compat``
# (and any other openai-compatible profile like ``deepseek_chat``) will
# route through it instead of the OpenAI default.
#
# Examples:
#   DeepSeek:        https://api.deepseek.com
#   Moonshot:        https://api.moonshot.cn/v1
#   Volcengine Ark:  https://ark.cn-beijing.volces.com/api/v3
#   OpenRouter:      https://openrouter.ai/api/v1
#   Ollama (local):  http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
# Optional extra request headers, one per line, e.g.:
# OPENAI_COMPAT_HEADERS=HTTP-Referer: https://example.com
#                      X-Title: DeepDraw

# ─── DeepDraw agent routing (optional) ─────────────────────────────────────────
# DEEPDRAW_LLM_DEFAULT        default profile used by all agents
# DEEPDRAW_LLM_<AGENT>        per-agent override; AGENT ∈
#                             SPEC_INTERPRETER / DRAWING_AUDITOR /
#                             BOM_GENERATOR / PROCESS_RECOMMENDER /
#                             CHIEF_VERIFIER
#
# Built-in profile names:
#   gpt4o, gpt4o_mini                (OpenAI official)
#   claude_opus_46, claude_sonnet_45 (Anthropic official)
#   deepseek_chat                    (DeepSeek official, openai-compatible)
#   openai_compat                    (whatever OPENAI_COMPAT_* says)
#
# Examples:
#   DEEPDRAW_LLM_DEFAULT=openai_compat
#   DEEPDRAW_LLM_CHIEF_VERIFIER=claude_opus_46
#   DEEPDRAW_LLM_PROCESS_RECOMMENDER=deepseek_chat

# ─── LangSmith observability (optional) ────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deepdraw
